<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Random Ten helps you explore unfamiliar skills and make your next decision using experience, not expectation.">
  <title>Random Ten — A Different Way to Find Direction</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <script src="/public/js/home.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class="site-header" data-site-header>
    <div class="shell site-header__inner">
      <a class="wordmark" href="#top" aria-label="Random Ten home">RANDOM TEN</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="menu-toggle__label">Menu</span>
        <span class="menu-toggle__icon" aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-menu" aria-label="Primary" data-site-menu>
        <a href="#method">How it works</a>
        <a href="#skills">Skills</a>
        <a href="#journey">Journey</a>
        <a href="#about">About</a>
        <button class="nav-join" type="button" data-waitlist-open>Join</button>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="shell hero__layout">
        <div class="hero__copy">
          <p class="eyebrow">A different way to find direction</p>
          <h1 id="hero-title">You were told<br>to choose one path.<br><span>What if that<br>was the problem?</span></h1>
          <p class="hero__intro">Random Ten helps you explore unfamiliar skills, understand what feels natural and make your next decision using experience—not expectation.</p>
          <div class="button-row">
            <a class="button button--primary" href="#choice">Start exploring</a>
            <a class="button button--secondary" href="#method">See how it works</a>
          </div>
          <p class="proof-line">Thirty skills. Three phases. One year of intentional exploration.</p>
        </div>
        <div class="hero-field" aria-label="Examples from the thirty-skill world" data-hero-skills>
          <% skills.slice(0, 10).forEach(function(skill, index) { %><span<%= index === 3 ? ' class="hero-field__active"' : '' %>><%= skill.name %></span><% }); %>
        </div>
        <p class="section-transition hero__transition">First, understand why choosing feels so difficult. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="choice section-dark" id="choice" aria-labelledby="choice-title">
      <div class="shell">
        <p class="eyebrow eyebrow--light">The choice problem</p>
        <div class="section-intro section-intro--split">
          <h2 id="choice-title">More choice<br>does not always<br>create more freedom.</h2>
          <div>
            <p>We are taught that the right answer is waiting inside us. Then we are handed an endless list and asked to choose before we have evidence.</p>
            <p>Random Ten changes the starting point: less speculation, more direct experience.</p>
          </div>
        </div>
        <div class="choice-sequence" aria-label="How increasing choice creates overload" data-choice-sequence>
          <% [6, 12, 30].forEach(function(count, stateIndex) { const messages = ['This feels manageable.', 'You are starting to compare.', 'Now which one do you choose?']; const markers = ['Calm', 'Comparison', 'Overload']; %>
            <article data-choice-state="<%= stateIndex %>">
              <div class="choice-sequence__marker"><span class="choice-sequence__number"><%= String(count).padStart(2, '0') %></span><span><%= markers[stateIndex] %> · <%= stateIndex + 1 %>/3</span></div>
              <h3><%= messages[stateIndex] %></h3>
              <ul class="choice-options" aria-label="<%= count %> skill options">
                <% skills.slice(0, count).forEach(function(skill) { %><li><%= skill.name %></li><% }); %>
              </ul>
            </article>
          <% }); %>
        </div>
        <div class="interruption" data-choice-interruption>
          <p>This is where most people stop.<br><strong>So Random Ten removes the decision.</strong></p>
          <button class="button button--light" type="button" disabled data-randomise>Randomise my ten</button>
          <div class="randomiser" data-randomiser hidden>
            <h3>Your first ten</h3>
            <p>No safe choices. No overthinking. Just genuine exposure.</p>
            <ol class="randomiser__results" data-random-results></ol>
            <button class="button button--outline-light" type="button" data-randomise-again>Randomise again</button>
          </div>
          <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-random-announcement></p>
        </div>
        <p class="section-transition section-transition--dark">From overload to a smaller place to begin. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="method" id="method" aria-labelledby="method-title">
      <div class="shell">
        <p class="eyebrow">The Random Ten method</p>
        <div class="section-intro">
          <h2 id="method-title">Clarity does not<br>come before action.<br><span>It comes because of it.</span></h2>
          <p class="framework-line" aria-label="Try, then reflect, then score, then follow the signal">Try <span>→</span> Reflect <span>→</span> Score <span>→</span> Follow the signal</p>
        </div>
        <div class="method-stages" data-method-stages>
          <% const methodStages = [
            ['Try', 'Enter an unfamiliar skill through a small, beginner-friendly experiment. The goal is exposure, not expertise.'],
            ['Reflect', 'Notice what happened while the experience is fresh: what pulled you in, resisted you or made time disappear.'],
            ['Score', 'Record enjoyment, curiosity, natural connection, energy and persistence. Keep opportunity separate from personal signal.'],
            ['Follow the signal', 'Use patterns across several experiences to decide what deserves deeper attention next.']
          ]; %>
          <% methodStages.forEach(function(stage, index) { %>
            <article data-method-stage="<%= index %>">
              <button type="button" aria-expanded="<%= index === 0 ? 'true' : 'false' %>" aria-controls="method-panel-<%= index %>" data-method-button>
                <span><%= String(index + 1).padStart(2, '0') %></span><strong><%= stage[0] %></strong><em data-method-state><%= index === 0 ? 'Active stage' : 'View stage' %></em>
              </button>
              <div id="method-panel-<%= index %>" data-method-panel><p><%= stage[1] %></p></div>
            </article>
          <% }); %>
        </div>
        <aside class="score-note" aria-label="Scoring clarification">
          <div><span>01</span><strong>Personal Signal Score</strong><p>Records your felt experience: enjoyment, curiosity, natural connection, energy and persistence.</p></div>
          <div><span>02</span><strong>Opportunity Score</strong><p>Considers the world around the skill separately from how the experience felt.</p></div>
          <p class="score-note__disclaimer">The score is not a personality diagnosis. It is a record of your experience at one moment in time.</p>
        </aside>
        <p class="section-transition">Experiments become evidence. Evidence becomes direction. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="journey" id="journey" aria-labelledby="journey-title">
      <div class="shell">
        <p class="eyebrow">Explore → Discover → Master</p>
        <div class="section-intro section-intro--split">
          <h2 id="journey-title">One year.<br><br>Not to pause<br>your life.<br><br>To understand<br>where it should go.</h2>
          <p>A paced framework for moving from broad exposure to a more deliberate commitment. The journey is being built and tested; details may evolve with evidence.</p>
        </div>
        <nav class="journey-nav" aria-label="Journey phases" data-journey-nav>
          <button type="button" class="is-active" aria-current="step" data-journey-target="0"><span>01</span>Explore</button>
          <button type="button" data-journey-target="1"><span>02</span>Discover</button>
          <button type="button" data-journey-target="2"><span>03</span>Master</button>
        </nav>
        <ol class="journey-path" data-journey-path>
          <li data-journey-phase="0"><span>Months 1–3</span><h3>Explore</h3><strong data-journey-state>Active phase</strong><p>Meet unfamiliar skills through bounded experiments. Pay attention before narrowing down.</p></li>
          <li data-journey-phase="1"><span>Months 4–6</span><h3>Discover</h3><strong data-journey-state>Future phase</strong><p>Revisit the strongest signals, compare experiences and understand what keeps drawing you back.</p></li>
          <li data-journey-phase="2"><span>Months 7–12</span><h3>Master</h3><strong data-journey-state>Future phase</strong><p>Choose where to stop sampling and begin building with greater consistency and intent.</p></li>
        </ol>
        <p class="journey-clarification">Master does not mean finished. It means you have chosen to stop sampling and begin building.</p>
        <p class="section-transition">Breadth first. Then patterns. Then depth. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="skills" id="skills" aria-labelledby="skills-title">
      <div class="shell">
        <p class="eyebrow">The thirty-skill world</p>
        <div class="section-intro section-intro--split">
          <h2 id="skills-title">Thirty doors.<br><br>You do not need<br>to know which one<br>is yours yet.</h2>
          <div><p>Each door begins with a small experiment. Search the world, follow a signal or let chance interrupt your usual choices.</p><p class="dataset-note"><%= skills.length %> skills across unfamiliar forms of making, expression, service and practice.</p></div>
        </div>
        <% const categories = [...new Set(skills.map(function(skill) { return skill.category; }))]; %>
        <div class="skill-tools" data-skill-tools>
          <div class="skill-search"><label for="skill-search">Search skills, categories or signals</label><input id="skill-search" type="search" autocomplete="off" data-skill-search></div>
          <div class="skill-actions"><button class="button button--secondary" type="button" data-surprise>Surprise me</button><button class="button button--secondary" type="button" data-skill-reset>Reset</button></div>
          <div class="skill-filters" aria-label="Filter skills by category" data-skill-filters>
            <button type="button" class="is-active" aria-pressed="true" data-category="all">All</button>
            <% categories.forEach(function(category) { %><button type="button" aria-pressed="false" data-category="<%= category %>"><%= category %></button><% }); %>
          </div>
          <p class="skill-count" role="status" aria-live="polite" data-skill-count><%= skills.length %> skills shown</p>
        </div>
        <div class="skill-directory">
        <ol class="skill-index" data-skill-list>
          <% skills.forEach(function(skill, skillIndex) { %>
            <li class="skill-row<%= skillIndex === 0 || skills[skillIndex - 1].category !== skill.category ? ' skill-row--category-start' : '' %>" id="skill-<%= skill.slug %>" data-skill-id="<%= skill.id %>" data-skill-category="<%= skill.category %>">
              <details>
                <summary aria-label="Select <%= skill.name %>">
                  <span class="skill-row__number"><%= String(skill.id).padStart(2, '0') %></span>
                  <span class="skill-row__name"><%= skill.name %></span>
                  <span class="skill-row__category"><%= skill.category %></span>
                  <span class="skill-row__action" aria-hidden="true">Explore</span>
                </summary>
                <div class="skill-row__detail">
                  <p><%= skill.description %></p>
                  <dl>
                    <div><dt>First experiment</dt><dd><%= skill.experiment %></dd></div>
                    <div><dt>Starting point</dt><dd><%= skill.duration %> · <%= skill.level %> · <%= skill.format %></dd></div>
                    <div><dt>Signals to notice</dt><dd><%= skill.signals.join(', ') %></dd></div>
                    <div><dt>Possible pathways</dt><dd><%= skill.pathways.join(', ') %></dd></div>
                  </dl>
                </div>
              </details>
            </li>
          <% }); %>
        </ol>
        <aside class="skill-preview" aria-live="polite" data-skill-preview>
          <p class="skill-preview__number" data-preview-number>01</p><p class="skill-preview__status" data-preview-status>Preview</p>
          <h3 data-preview-name><%= skills[0].name %></h3><p data-preview-category><%= skills[0].category %></p><p data-preview-description><%= skills[0].description %></p>
          <dl><div><dt>First experiment</dt><dd data-preview-experiment><%= skills[0].experiment %></dd></div><div><dt>Signals</dt><dd data-preview-signals><%= skills[0].signals.join(', ') %></dd></div><div><dt>Possible pathways</dt><dd data-preview-pathways><%= skills[0].pathways.join(', ') %></dd></div></dl>
          <p class="skill-preview__surprise" data-surprise-message hidden>You may never have chosen this.<br><strong>That is the point.</strong></p>
        </aside>
        </div>
        <p class="no-results" data-no-results hidden>No skills match this search. Try another word or reset the filters.</p>
        <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-skill-announcement></p>
        <p class="section-transition">The system matters. So does the reason it exists. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="founder section-dark" id="about" aria-labelledby="founder-title">
      <div class="shell founder__layout">
        <div>
          <p class="eyebrow eyebrow--light">Why Random Ten exists</p>
          <h2 id="founder-title">I did not build<br>Random Ten because<br>I had everything<br>figured out.<br><br><span>I built it<br>because I did not.</span></h2>
        </div>
        <div class="founder__story">
          <div class="media-placeholder founder-film-poster" role="img" aria-label="Founder film in production. The story behind Random Ten. Coming soon.">
            <span>Founder film in production</span><strong>The story behind Random Ten</strong><em>Coming soon</em>
          </div>
          <p>Random Ten starts from a familiar tension: being capable of many things but certain of none. Instead of asking people to declare a calling, it creates a structure for gathering evidence through action.</p>
          <p class="build-status">Random Ten is currently being built and tested.</p>
        </div>
        <div class="principles" aria-label="Three founding principles">
          <article><span>01</span><h3>Experience before identity</h3><p>You do not need to call yourself something before you are allowed to try it.</p></article>
          <article><span>02</span><h3>Evidence before certainty</h3><p>Small real encounters are more useful than perfect imaginary plans.</p></article>
          <article><span>03</span><h3>Direction before destination</h3><p>A trustworthy next step matters more than a permanent answer.</p></article>
        </div>
        <div class="journey-so-far">
          <h3>Journey so far</h3>
          <ol>
            <li><span>Origin</span><p>A personal question becomes a testable method.</p></li>
            <li><span>Now</span><p>The homepage, skill framework and first participant pathway are being built.</p></li>
            <li><span>Next</span><p>Test small experiences, listen carefully and publish what is learned.</p></li>
          </ol>
        </div>
        <blockquote class="founder-belief">When I think I can,<br>I will.</blockquote>
        <p class="section-transition section-transition--dark">A personal question becomes a shared experiment. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="community" id="community" aria-labelledby="community-title">
      <div class="shell">
        <p class="eyebrow">Community, proposed honestly</p>
        <div class="section-intro section-intro--split">
          <h2 id="community-title">Discovery should<br>not happen alone.<br><br>The internet can<br>introduce a skill.<br><br><span>Real people<br>make it come alive.</span></h2>
          <div><p>The proposed community model connects online discovery with careful real-world practice and shared reflection.</p><p><strong>London-first testing strategy:</strong> currently exploring small, responsible formats. No public events, experts or venues are confirmed.</p></div>
        </div>
        <ol class="community-model">
          <li><span>01</span><h3>Discover online</h3><p>Meet a skill, its first experiment and the signals worth noticing.</p></li>
          <li><span>02</span><h3>Meet the expert</h3><p>Proposed format: hear how a real practitioner thinks, works and began.</p></li>
          <li><span>03</span><h3>Try it in person</h3><p>Example session format: a safe, bounded introduction with suitable supervision.</p></li>
          <li><span>04</span><h3>Reflect together</h3><p>Proposed format: reflection circles, showcases and shared next steps.</p></li>
        </ol>
        <div class="community-status">
          <div class="media-placeholder media-placeholder--wide" role="img" aria-label="Community media placeholder. No live Random Ten community event is pictured."><span>Community media</span><strong>Not yet live</strong></div>
          <div><p class="status-label">Currently exploring</p><h3>Expert sessions, skill meetups, reflection circles and showcases.</h3><p>A future volunteer pathway may help people host and support experiments. It is not yet open.</p><div class="button-row"><button class="button button--primary" type="button" data-waitlist-open>Join as a participant</button><a class="button button--secondary" href="#collaborate">Explore collaboration</a></div></div>
        </div>
        <div class="community-definitions" aria-label="Community status definitions">
          <div><strong>Currently building</strong><p>The digital discovery framework and first participant pathway.</p></div>
          <div><strong>Proposed format</strong><p>Expert introductions, bounded practice and group reflection.</p></div>
          <div><strong>Not yet live</strong><p>Public events, a volunteer pathway, venues and regular programming.</p></div>
          <div><strong>Long-term vision</strong><p>A credible bridge between online discovery and real-world practice.</p></div>
        </div>
        <p class="section-transition">Interest becomes participation—carefully and honestly. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="offer" id="join" aria-labelledby="offer-title">
      <div class="shell">
        <p class="eyebrow">Two ways to begin</p>
        <h2 id="offer-title">Follow the build.<br>Or join the experiment.</h2>
        <div class="offer-paths">
          <article>
            <span>01 — Follow the build</span>
            <h3>Join the founding waitlist</h3>
            <p>Free. Receive significant project updates and hear when the first participant opportunities become available.</p>
            <ul><li>Name, email and optional city only</li><li>No payment required</li><li>Leave whenever you choose</li></ul>
            <button class="button button--primary" type="button" data-waitlist-open>Join the founding waitlist</button>
          </article>
          <article id="application-status">
            <span>02 — Join the experiment</span>
            <h3>Apply for the first cohort</h3>
            <p>The founding cohort is planned as a small application-only test of the method. Applications are not yet open.</p>
            <ul><li>Founding price announced before applications open</li><li>Programme details may change during testing</li><li>No outcome or career change is guaranteed</li></ul>
            <a class="button button--secondary" href="#application-note">Applications opening soon</a>
            <p class="application-note" id="application-note" tabindex="-1">No application or payment is being collected in this phase.</p>
          </article>
        </div>
        <div class="offer-boundaries">
          <div><p class="status-label">What the founding cohort is not</p><h3>Not a finished programme. Not a certification. Not a guaranteed career outcome.</h3></div>
          <div><p class="status-label">Future-facing roadmap</p><p>Applications, pricing and the detailed cohort format will only be published after the homepage and waitlist experience are stable and the testing plan is ready.</p></div>
        </div>
        <p class="section-transition">No perfect promise. Just an honest next step. <span aria-hidden="true">↓</span></p>
      </div>
    </section>

    <section class="final-close section-dark" aria-labelledby="final-title">
      <div class="shell final-close__inner">
        <p class="eyebrow eyebrow--light">Begin with evidence</p>
        <h2 id="final-title">You do not need<br>the perfect answer.<br><br>You need<br>the courage to begin<br>and the evidence<br>to continue.</h2>
        <p class="final-belief">When I think I can, I will.</p>
        <div class="button-row button-row--center">
          <button class="button button--primary" type="button" data-waitlist-open>Join the founding waitlist</button>
          <a class="button button--text-light" href="#application-status">Apply for the first cohort <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer" id="collaborate">
    <div class="shell site-footer__grid">
      <div><a class="wordmark" href="#top">RANDOM TEN</a><p>A different way to find direction.</p></div>
      <div><h2>Explore</h2><a href="#method">How it works</a><a href="#skills">Skills</a><a href="#journey">Journey</a></div>
      <div><h2>Participate</h2><button type="button" data-waitlist-open>Join the waitlist</button><a href="#application-status">First cohort</a><span>Collaborator pathway — coming soon</span></div>
      <div><h2>Follow</h2><span>Build updates — coming soon</span><span>Social channels — not yet published</span></div>
      <div><h2>Information</h2><span>Contact — coming before paid launch</span><span>Privacy — coming before paid launch</span><span>Terms — coming before paid launch</span><span>Accessibility — coming before paid launch</span></div>
    </div>
    <div class="shell site-footer__base"><p>© <span data-current-year>2026</span> Random Ten.</p><p>Currently being built and tested.</p></div>
  </footer>

  <div class="modal-layer" data-waitlist-modal hidden>
    <div class="modal-backdrop" data-waitlist-backdrop></div>
    <section class="modal" role="dialog" aria-modal="true" aria-labelledby="waitlist-title" aria-describedby="waitlist-description">
      <button class="modal__close" type="button" aria-label="Close waitlist form" data-waitlist-close>×</button>
      <p class="eyebrow">Join the founding waitlist</p>
      <h2 id="waitlist-title">Begin with one small step.</h2>
      <p id="waitlist-description">Be among the earliest to hear what Random Ten learns and when participant opportunities open.</p>
      <form data-waitlist-form novalidate>
        <div class="form-field"><label for="waitlist-name">Your name</label><input id="waitlist-name" name="name" type="text" autocomplete="name" maxlength="120" required></div>
        <div class="form-field"><label for="waitlist-email">Email address</label><input id="waitlist-email" name="email" type="email" autocomplete="email" maxlength="254" required></div>
        <div class="form-field"><label for="waitlist-city">Your city <span>Optional</span></label><input id="waitlist-city" name="city" type="text" autocomplete="address-level2" maxlength="100"></div>
        <button class="button button--primary button--full" type="submit" data-waitlist-submit>Join the founding waitlist</button>
        <div class="form-feedback" role="status" aria-live="polite" aria-atomic="true" data-waitlist-feedback></div>
      </form>
      <p class="form-privacy">No payment. No confirmed cohort place. Just honest updates as the project develops.</p>
    </section>
  </div>

  <div class="modal-layer" data-founder-film-modal hidden>
    <div class="modal-backdrop" data-founder-film-backdrop></div>
    <section class="modal film-modal" role="dialog" aria-modal="true" aria-labelledby="founder-film-title" aria-describedby="founder-film-description">
      <button class="modal__close" type="button" aria-label="Close founder film information" data-founder-film-close>×</button>
      <p class="eyebrow">Founder film in production</p>
      <h2 id="founder-film-title">No film is available yet.</h2>
      <p id="founder-film-description">This accessible shell shows where the real founder film will live once it has been produced, reviewed and captioned.</p>
      <div class="film-placeholder" aria-label="Inactive video placeholder"><span aria-hidden="true">▶</span><strong>Video intentionally unavailable</strong><p>No autoplay. No fabricated footage.</p></div>
      <div class="transcript-placeholder"><h3>Transcript</h3><p>A complete transcript will be published here with the real film. Captions and a text alternative are required before launch.</p></div>
    </section>
  </div>

  <script id="skills-data" type="application/json"><%- JSON.stringify(skills).replace(/</g, '\\u003c') %></script>
</body>
</html>
