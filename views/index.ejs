  <!-- ══ WAITLIST MODAL ═════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="waitlist-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
    <div class="modal">
      <button class="modal__close" onclick="closeWaitlist()" aria-label="Close waitlist form">✕</button>
      <p class="modal__eyebrow">Join the Waitlist</p>
      <h3 class="modal__title" id="modal-title">Reserve your place before enrolment opens.</h3>
      <form id="waitlist-form" novalidate>
        <div class="form-group">
          <label for="wl-name">Your name</label>
          <input type="text" id="wl-name" name="name" placeholder="Full name" autocomplete="name" required aria-required="true">
        </div>
        <div class="form-group">
          <label for="wl-email">Email address</label>
          <input type="email" id="wl-email" name="email" placeholder="your@email.com" autocomplete="email" required aria-required="true">
        </div>
        <div class="form-group">
          <label for="wl-city">Your city <span style="color:var(--grey);font-weight:400">(optional)</span></label>
          <input type="text" id="wl-city" name="city" placeholder="London, Mumbai, Dubai…">
        </div>
        <button type="submit" class="btn btn--gold btn--full" id="waitlist-submit">
          Secure My Place
        </button>
        <div id="waitlist-feedback" aria-live="polite"></div>
      </form>
    </div>
  </div>

  <!-- ══ TOAST ══════════════════════════════════════════════════════════════ -->
  <div class="toast" id="toast" role="alert" aria-live="assertive"></div>

  <!-- ══ SCRIPTS ════════════════════════════════════════════════════════════ -->
  <script>
    // ── Waitlist modal ──────────────────────────────────────────────────
    function openWaitlist() {
      const modal = document.getElementById('waitlist-modal');
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      document.getElementById('wl-name').focus();
    }
    function closeWaitlist() {
      document.getElementById('waitlist-modal').hidden = true;
      document.body.style.overflow = '';
    }
    document.getElementById('waitlist-modal').addEventListener('click', function(e) {
      if (e.target === this) closeWaitlist();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeWaitlist();
    });

    // ── Waitlist form submit ────────────────────────────────────────────
    document.getElementById('waitlist-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('waitlist-submit');
      const feedback = document.getElementById('waitlist-feedback');
      const name  = document.getElementById('wl-name').value.trim();
      const email = document.getElementById('wl-email').value.trim();
      const city  = document.getElementById('wl-city').value.trim();

      if (!name || !email) {
        feedback.innerHTML = '<p class="form-error">Please enter your name and email.</p>';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Securing your place…';
      feedback.innerHTML = '';

      try {
        const res  = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, city }),
        });
        const data = await res.json();

        if (res.ok) {
          feedback.innerHTML = `<p class="form-success">You are on the list, ${name}. Check your inbox.</p>`;
          btn.textContent = 'You are in.';
          showToast('Welcome to Random Ten. Your place is reserved.');
          setTimeout(closeWaitlist, 2500);
        } else {
          feedback.innerHTML = `<p class="form-error">${data.error || 'Something went wrong.'}</p>`;
          btn.disabled = false;
          btn.textContent = 'Secure My Place';
        }
      } catch {
        feedback.innerHTML = '<p class="form-error">Connection error. Please try again.</p>';
        btn.disabled = false;
        btn.textContent = 'Secure My Place';
      }
    });

    // ── Stripe Checkout ─────────────────────────────────────────────────
    async function handleCheckout() {
      const btn = document.getElementById('checkout-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Loading…'; }

      try {
        const res  = await fetch('/api/checkout', { method: 'POST' });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          showToast(data.error || 'Could not open payment. Please try again.');
          if (btn) { btn.disabled = false; btn.textContent = 'Enrol Now — £650'; }
        }
      } catch {
        showToast('Connection error. Please try again.');
        if (btn) { btn.disabled = false; btn.textContent = 'Enrol Now — £650'; }
      }
    }

    // ── Smooth scroll ───────────────────────────────────────────────────
    function scrollTo(id) {
      document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
    }

    // ── Toast notification ──────────────────────────────────────────────
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('toast--visible');
      setTimeout(() => t.classList.remove('toast--visible'), 4000);
    }

    // ── Scroll reveal ───────────────────────────────────────────────────
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    document.querySelectorAll('.phase, .problem__card, .skill-card, .testimonial, .pricing__card')
      .forEach(el => observer.observe(el));
  </script>

</body>
</html>
