<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to Random Ten</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&family=Cormorant+Garamond:ital,wght@1,300&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/style.css">
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; text-align:center; }
    .result-card { max-width:520px; padding:60px 48px; background:var(--navy-light); border:1px solid rgba(245,166,35,0.2); border-radius:8px; }
    .result-icon { font-size:56px; margin-bottom:24px; }
    .result-card h1 { font-size:32px; margin-bottom:16px; }
    .result-card p { color:var(--grey); line-height:1.7; margin-bottom:32px; }
  </style>
</head>
<body>
  <div class="result-card">
    <div class="result-icon">✦</div>
    <p style="color:var(--gold);font-size:12px;letter-spacing:0.25em;font-weight:700;margin-bottom:16px">RANDOM TEN</p>
    <h1>You are in.</h1>
    <p>Your enrolment is confirmed. Check your inbox for a confirmation and your onboarding details. Your year of discovery begins now.</p>
    <a href="/" class="btn btn--gold">Back to Home</a>
  </div>
</body>
</html>
