<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Random Ten</title>
  <style>
    :root { --navy:#1A1A2E; --gold:#F5A623; --red:#E94560; --white:#fff; --grey:#9CA3AF; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:system-ui,sans-serif; background:#0D0D18; color:var(--white); padding:40px 24px; }
    h1 { color:var(--gold); font-size:24px; margin-bottom:4px; letter-spacing:0.1em; }
    .sub { color:var(--grey); font-size:13px; margin-bottom:40px; }
    h2 { font-size:16px; margin-bottom:16px; color:var(--white); padding-bottom:8px; border-bottom:1px solid rgba(245,166,35,0.2); }
    .section { margin-bottom:48px; }
    .stat-row { display:flex; gap:24px; margin-bottom:32px; flex-wrap:wrap; }
    .stat { background:#1A1A2E; border:1px solid rgba(245,166,35,0.15); border-radius:6px; padding:20px 28px; }
    .stat__num { font-size:32px; font-weight:700; color:var(--gold); }
    .stat__label { font-size:12px; color:var(--grey); margin-top:4px; letter-spacing:0.1em; }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th { text-align:left; padding:10px 12px; background:#1A1A2E; color:var(--gold); font-size:11px; letter-spacing:0.15em; border-bottom:1px solid rgba(255,255,255,0.08); }
    td { padding:10px 12px; border-bottom:1px solid rgba(255,255,255,0.05); color:rgba(255,255,255,0.8); }
    tr:hover td { background:rgba(255,255,255,0.02); }
    .badge { display:inline-block; padding:2px 8px; border-radius:3px; font-size:11px; font-weight:700; }
    .badge--green { background:rgba(46,196,182,0.15); color:#2EC4B6; }
    .badge--gold {
  background: rgba(245,166,35,0.14);
  color: var(--gold);
}

.badge--red {
  background: rgba(233,69,96,0.14);
  color: var(--red);
}

.badge--grey {
  background: rgba(156,163,175,0.14);
  color: var(--grey);
}

.table-wrap {
  width: 100%;
  overflow-x: auto;
}
    .empty { color:var(--grey); font-size:13px; padding:20px 0; }
  </style>
</head>
<body>
  <h1>RANDOM TEN — ADMIN</h1>
  <p class="sub">Internal dashboard. Keep this URL private.</p>

  <div class="stat-row">
    <div class="stat">
  <div class="stat__num"><%= foundingExplorers.length %></div>
  <div class="stat__label">FOUNDING 100 APPLICATIONS</div>
</div>
    <div class="stat">
      <div class="stat__num"><%= waitlist.length %></div>
      <div class="stat__label">WAITLIST SIGNUPS</div>
    </div>
    <div class="stat">
      <div class="stat__num"><%= payments.length %></div>
      <div class="stat__label">COMPLETED PAYMENTS</div>
    </div>
    <div class="stat">
      <div class="stat__num">
        £<%= (payments.reduce((sum, p) => sum + (p.amount_total || 0), 0) / 100).toLocaleString() %>
      </div>
      <div class="stat__label">TOTAL REVENUE</div>
    </div>
  </div>
<div class="section">

  <h2>Founding 100 Applications</h2>

  <% if (foundingExplorers.length === 0) { %>

    <p class="empty">
      No Founding Explorer applications yet.
    </p>

  <% } else { %>

    <div class="table-wrap">

      <table>

        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Age</th>
            <th>Location</th>
            <th>Situation</th>
            <th>Trying to figure out</th>
            <th>Barrier</th>
            <th>Commitment</th>
            <th>Source</th>
            <th>Restrictions</th>
            <th>Story</th>
            <th>Status</th>
            <th>Date</th>
          </tr>
        </thead>

        <tbody>

          <% foundingExplorers.forEach(function(f, i) { %>

            <tr>

              <td><%= i + 1 %></td>

              <td>
                <strong>
                  <%= f.first_name %> <%= f.last_name %>
                </strong>
              </td>

              <td>
                <a
                  href="mailto:<%= f.email %>"
                  style="color:var(--gold);text-decoration:none;"
                >
                  <%= f.email %>
                </a>
              </td>

              <td>
                <%= f.age_range || '—' %>
              </td>

              <td>
                <%= f.location || '—' %>
              </td>

              <td>
                <%= f.situation || '—' %>
              </td>

              <td style="min-width:280px;line-height:1.5;">
                <%= f.current_question || '—' %>
              </td>

              <td>
                <%= f.barrier || '—' %>
              </td>

              <td>

                <% if (f.commitment === 'Yes') { %>

                  <span class="badge badge--green">
                    Yes
                  </span>

                <% } else if (f.commitment === 'Maybe') { %>

                  <span class="badge badge--gold">
                    Maybe
                  </span>

                <% } else { %>

                  <span class="badge badge--grey">
                    <%= f.commitment || '—' %>
                  </span>

                <% } %>

              </td>

              <td>
                <%= f.acquisition_source || '—' %>
              </td>

              <td style="min-width:220px;line-height:1.5;">
                <%= f.restrictions || '—' %>
              </td>

              <td>

                <% if (f.story_consent) { %>

                  <span class="badge badge--green">
                    YES
                  </span>

                <% } else { %>

                  <span class="badge badge--grey">
                    NO
                  </span>

                <% } %>

              </td>

              <td>

                <% if (f.status === 'accepted') { %>

                  <span class="badge badge--green">
                    ACCEPTED
                  </span>

                <% } else if (f.status === 'rejected') { %>

                  <span class="badge badge--red">
                    REJECTED
                  </span>

                <% } else { %>

                  <span class="badge badge--gold">
                    <%= (f.status || 'applied').toUpperCase() %>
                  </span>

                <% } %>

              </td>

              <td>
                <%= new Date(f.created_at).toLocaleDateString('en-GB') %>
              </td>

            </tr>

          <% }); %>

        </tbody>

      </table>

    </div>

  <% } %>

</div>
  <div class="section">
    <h2>Waitlist Signups</h2>
    <% if (waitlist.length === 0) { %>
      <p class="empty">No signups yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>#</th><th>Name</th><th>Email</th><th>City</th><th>Source</th><th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% waitlist.forEach(function(w, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= w.name %></td>
              <td><%= w.email %></td>
              <td><%= w.city || '—' %></td>
              <td><%= w.source %></td>
              <td><%= new Date(w.created_at).toLocaleDateString('en-GB') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div class="section">
    <h2>Payments</h2>
    <% if (payments.length === 0) { %>
      <p class="empty">No payments yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>#</th><th>Name</th><th>Email</th><th>Amount</th><th>Status</th><th>Stripe Session</th><th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% payments.forEach(function(p, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= p.customer_name || '—' %></td>
              <td><%= p.customer_email %></td>
              <td>£<%= ((p.amount_total || 0) / 100).toFixed(2) %></td>
              <td><span class="badge badge--green"><%= p.status %></span></td>
              <td style="font-size:11px;color:var(--grey)"><%= p.stripe_session_id.slice(0,24) %>…</td>
              <td><%= new Date(p.created_at).toLocaleDateString('en-GB') %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
