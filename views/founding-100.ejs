<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Founding 100 — Random 10</title>

  <meta
    name="description"
    content="Apply to become one of the first 100 Founding Explorers of Random 10."
  >

  <link rel="icon" href="/public/assets/brand/random10-icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/public/css/style.css">
</head>

<body>

  <header class="site-header">
    <div class="shell site-header__inner">
      <a href="/" class="site-logo" aria-label="Random 10 home">
        <img
          src="/public/assets/brand/random10-logo-primary.svg"
          alt="Random 10"
        >
      </a>

      <a class="button button--secondary" href="/">
        Back to Random 10
      </a>
    </div>
  </header>

  <main>

    <% if (submitted) { %>

      <section class="founding-confirmation">
        <div class="shell founding-confirmation__inner">

          <p class="eyebrow">FOUNDING EXPLORERS</p>

          <h1>
            YOU'VE OPENED<br>
            THE FIRST DOOR.
          </h1>

          <p class="founding-confirmation__lead">
            Your application is in.
          </p>

          <p>
            We're bringing the first group in gradually so we can actually
            speak to people, observe how they use Random 10 and improve the
            method while it is still being built.
          </p>

          <div class="founding-confirmation__prompt">
            <p class="eyebrow">WHILE YOU WAIT</p>

            <h2>
              Find one thing you've never
              seriously considered doing.
            </h2>

            <p>
              Notice your immediate reaction.
            </p>

            <p>
              Curiosity? Resistance? Excitement?
              <br>
              “Absolutely not”?
            </p>

            <p>
              Don't analyse it yet.
              <br>
              <strong>Just notice it.</strong>
            </p>
          </div>

          <div class="button-row">
            <a class="button button--primary" href="/#skills">
              Explore the Thirty Doors
            </a>

            <a class="button button--secondary" href="/">
              Back to Random 10
            </a>
          </div>

        </div>
      </section>

    <% } else { %>

      <section class="founding-hero">
        <div class="shell founding-hero__inner">

          <div>
            <p class="eyebrow">FOUNDING EXPLORERS</p>

            <h1>
              THE FIRST 100 PEOPLE<br>
              TO STOP THINKING<br>
              AND START TESTING.
            </h1>
          </div>

          <div class="founding-hero__copy">
            <p class="founding-hero__lead">
              You do not need to know what you want to do next.
            </p>

            <p>
              You just need to be willing to find out.
            </p>

            <p>
              Random 10 is looking for its first 100 explorers — people
              willing to test unfamiliar possibilities, gather real evidence
              about themselves and help shape the system while it is still
              being built.
            </p>

            <a class="button button--primary" href="#apply">
              Apply to be a Founding Explorer
            </a>

            <p class="founding-meta">
              Free to join · Limited founding cohort
            </p>
          </div>

        </div>
      </section>


      <section class="founding-process section-dark">
        <div class="shell">

          <p class="eyebrow eyebrow--light">HOW IT WORKS</p>

          <div class="section-intro section-intro--split">
            <h2>
              YOU WON'T BE ASKED<br>
              TO CHOOSE YOUR FUTURE.
            </h2>

            <p>
              You'll be asked to run an experiment.
            </p>
          </div>

          <div class="founding-steps">

            <article>
              <p class="founding-step__number">01</p>
              <h3>Receive your ten</h3>
              <p>
                Random 10 gives you ten possibilities across unfamiliar forms
                of making, expression, movement, service and practice.
              </p>
            </article>

            <article>
              <p class="founding-step__number">02</p>
              <h3>Pick one door</h3>
              <p>
                Choose the possibility that creates curiosity, resistance or
                surprise.
              </p>
            </article>

            <article>
              <p class="founding-step__number">03</p>
              <h3>Try it</h3>
              <p>
                Complete one small real-world experiment. It may take thirty
                minutes, an afternoon or several days.
              </p>
            </article>

            <article>
              <p class="founding-step__number">04</p>
              <h3>Reflect</h3>
              <p>
                Capture what actually happened — not what you expected to
                happen.
              </p>
            </article>

            <article>
              <p class="founding-step__number">05</p>
              <h3>Follow the signal</h3>
              <p>
                Decide whether to follow it, explore it further or leave it
                behind.
              </p>
            </article>

          </div>

        </div>
      </section>


      <section class="founding-belief">
        <div class="shell">

          <p class="eyebrow">THE COMMITMENT</p>

          <div class="section-intro section-intro--split">

            <h2>
              ONE REAL<br>
              EXPERIMENT.
            </h2>

            <div>
              <p>
                If selected, we ask for one thing:
              </p>

              <p class="founding-belief__statement">
                Complete at least one genuine Random 10 experiment and reflect
                on what you discovered.
              </p>

              <p>
                You do not need to love the experiment.
              </p>

              <p>
                <strong>
                  Finding out that something isn't for you is still evidence.
                </strong>
              </p>
            </div>

          </div>

        </div>
      </section>


      <section class="founding-fit section-dark">
        <div class="shell founding-fit__grid">

          <div>
            <p class="eyebrow eyebrow--light">THIS MAY BE FOR YOU</p>

            <h2>
              IF YOU HAVE<br>
              OPTIONS BUT<br>
              NOT ENOUGH<br>
              EVIDENCE.
            </h2>
          </div>

          <div class="founding-fit__lists">

            <div>
              <h3>This is probably for you if...</h3>

              <ul>
                <li>You have several possible directions and struggle to choose.</li>
                <li>You keep researching instead of trying.</li>
                <li>You feel like you should already know what you're passionate about.</li>
                <li>You are curious about things you've never seriously explored.</li>
                <li>You are willing to test assumptions about yourself.</li>
              </ul>
            </div>

            <div>
              <h3>This is probably not for you if...</h3>

              <ul>
                <li>You only want another personality or career quiz.</li>
                <li>You are not currently willing to try something unfamiliar.</li>
                <li>You want Random 10 to tell you exactly what career to choose.</li>
              </ul>
            </div>

          </div>

        </div>
      </section>


      <section class="founding-apply" id="apply">
        <div class="shell founding-apply__grid">

          <div class="founding-apply__intro">
            <p class="eyebrow">THE FOUNDING 100</p>

            <h2>
              APPLY TO<br>
              OPEN YOUR<br>
              FIRST DOOR.
            </h2>

            <p>
              Applications are reviewed gradually while we build and test the
              first complete Random 10 experience.
            </p>

            <p>
              There is no perfect answer.
              We are looking for genuine willingness to explore.
            </p>
          </div>


          <form
            class="founding-form"
            data-founding-form
            novalidate
          >

            <div class="form-grid form-grid--two">

              <div class="form-field">
                <label for="first_name">First name *</label>
                <input
                  id="first_name"
                  name="first_name"
                  type="text"
                  required
                  maxlength="80"
                >
              </div>

              <div class="form-field">
                <label for="last_name">Last name *</label>
                <input
                  id="last_name"
                  name="last_name"
                  type="text"
                  required
                  maxlength="80"
                >
              </div>

            </div>


            <div class="form-field">
              <label for="email">Email *</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                maxlength="254"
              >
            </div>


            <div class="form-grid form-grid--two">

              <div class="form-field">
                <label for="age_range">Age range *</label>

                <select id="age_range" name="age_range" required>
                  <option value="">Select</option>
                  <option value="18–21">18–21</option>
                  <option value="22–25">22–25</option>
                  <option value="26–30">26–30</option>
                  <option value="31–35">31–35</option>
                  <option value="36+">36+</option>
                </select>
              </div>

              <div class="form-field">
                <label for="location">Where are you based? *</label>
                <input
                  id="location"
                  name="location"
                  type="text"
                  required
                  placeholder="London, UK"
                  maxlength="120"
                >
              </div>

            </div>


            <div class="form-field">
              <label for="situation">Which best describes you right now? *</label>

              <select id="situation" name="situation" required>
                <option value="">Select</option>
                <option value="University student">University student</option>
                <option value="Recent graduate">Recent graduate</option>
                <option value="Early-career professional">Early-career professional</option>
                <option value="Considering a career change">Considering a career change</option>
                <option value="Building something of my own">Building something of my own</option>
                <option value="Between things / figuring it out">Between things / figuring it out</option>
                <option value="Other">Other</option>
              </select>
            </div>


            <div class="form-field">
              <label for="current_question">
                What are you currently trying to figure out? *
              </label>

              <textarea
                id="current_question"
                name="current_question"
                rows="5"
                required
                maxlength="1200"
              ></textarea>

              <p class="form-note">
                Career, interests, direction, something you want to change —
                there is no perfect answer.
              </p>
            </div>


            <div class="form-field">
              <label for="barrier">
                What usually stops you from exploring something new? *
              </label>

              <select id="barrier" name="barrier" required>
                <option value="">Select</option>
                <option value="Too many options">Too many options</option>
                <option value="Fear of wasting time">Fear of wasting time</option>
                <option value="Fear of choosing badly">Fear of choosing badly</option>
                <option value="Cost">Cost</option>
                <option value="Not knowing where to start">Not knowing where to start</option>
                <option value="Confidence">Confidence</option>
                <option value="Other people's expectations">Other people's expectations</option>
                <option value="I keep overthinking it">I keep overthinking it</option>
                <option value="Other">Other</option>
              </select>
            </div>


            <fieldset class="form-field founding-commitment">

              <legend>
                Would you genuinely commit to completing one unfamiliar
                real-world experiment in the next 14 days? *
              </legend>

              <label>
                <input
                  type="radio"
                  name="commitment"
                  value="Yes"
                  required
                >
                <span>Yes</span>
              </label>

              <label>
                <input
                  type="radio"
                  name="commitment"
                  value="Maybe"
                >
                <span>Maybe</span>
              </label>

              <label>
                <input
                  type="radio"
                  name="commitment"
                  value="Not currently"
                >
                <span>Not currently</span>
              </label>

            </fieldset>


            <div class="form-field">
              <label for="acquisition_source">
                How did you hear about Random 10?
              </label>

              <select
                id="acquisition_source"
                name="acquisition_source"
              >
                <option value="">Select</option>
                <option value="Instagram">Instagram</option>
                <option value="TikTok">TikTok</option>
                <option value="LinkedIn">LinkedIn</option>
                <option value="Friend">Friend</option>
                <option value="Durham University / alumni">
                  Durham University / alumni
                </option>
                <option value="Another university">
                  Another university
                </option>
                <option value="Creator">Creator</option>
                <option value="Event">Event</option>
                <option value="Search">Search</option>
                <option value="Other">Other</option>
              </select>
            </div>


            <div class="form-field">
              <label for="restrictions">
                Is there anything you absolutely cannot or do not want to try?
              </label>

              <textarea
                id="restrictions"
                name="restrictions"
                rows="3"
                maxlength="1000"
              ></textarea>

              <p class="form-note">
                Accessibility, health, religious, financial or other practical
                constraints are completely valid.
              </p>
            </div>


            <div class="founding-consents">

              <label class="form-checkbox">
                <input
                  type="checkbox"
                  name="programme_consent"
                  required
                >

                <span>
                  I agree to receive communications relating to the Random 10
                  Founding Explorer programme. *
                </span>
              </label>


              <label class="form-checkbox">
                <input
                  type="checkbox"
                  name="story_consent"
                >

                <span>
                  I'm happy for Random 10 to contact me separately about
                  potentially sharing my exploration story.
                </span>
              </label>

            </div>


            <div
              class="founding-form__message"
              data-founding-message
              role="status"
              aria-live="polite"
              hidden
            ></div>


            <button
              class="button button--primary founding-form__submit"
              type="submit"
            >
              Submit application
            </button>


            <p class="founding-form__privacy">
              Your information is used to review your application and operate
              the Founding Explorer programme. Story participation is optional.
            </p>

          </form>

        </div>
      </section>


      <section class="final-close section-dark">
        <div class="shell final-close__inner">

          <p class="eyebrow eyebrow--light">BEGIN WITH EVIDENCE</p>

          <h2>
            YOU DO NOT NEED<br>
            THE PERFECT ANSWER.<br><br>

            YOU NEED<br>
            THE COURAGE TO BEGIN<br>
            AND THE EVIDENCE<br>
            TO CONTINUE.
          </h2>

          <p class="final-belief">
            When I think I can, I will.
          </p>

          <div class="button-row button-row--center">
            <a class="button button--primary" href="#apply">
              Apply to the Founding 100
            </a>

            <a class="button button--text-light" href="/">
              Explore Random 10 →
            </a>
          </div>

        </div>
      </section>

    <% } %>

  </main>


  <script>
    const foundingForm = document.querySelector('[data-founding-form]');
    const foundingMessage = document.querySelector('[data-founding-message]');

    if (foundingForm) {
      foundingForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!foundingForm.checkValidity()) {
          foundingForm.reportValidity();
          return;
        }

        const submitButton = foundingForm.querySelector(
          '.founding-form__submit'
        );

        const originalText = submitButton.textContent;

        submitButton.disabled = true;
        submitButton.textContent = 'Submitting...';

        foundingMessage.hidden = true;
        foundingMessage.textContent = '';
        foundingMessage.classList.remove(
          'is-error',
          'is-success'
        );

        const formData = new FormData(foundingForm);
        const payload = Object.fromEntries(formData.entries());

        try {
          const response = await fetch('/api/founding-100', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(
              result.error || 'Something went wrong.'
            );
          }

          foundingMessage.textContent =
            'Application submitted. Opening the next door...';

          foundingMessage.classList.add('is-success');
          foundingMessage.hidden = false;

          window.location.href =
            '/founding-100?submitted=true';

        } catch (error) {

          foundingMessage.textContent = error.message;
          foundingMessage.classList.add('is-error');
          foundingMessage.hidden = false;

          submitButton.disabled = false;
          submitButton.textContent = originalText;
        }
      });
    }
  </script>

</body>
</html>